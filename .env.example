# Copie para .env e preencha os valores
DB_USER=eventsync
DB_PASSWORD=troque-esta-senha
DB_ROOT_PASSWORD=troque-esta-senha-root

# Base64 com 32+ bytes. Gere com:
#   Linux/macOS/Git Bash: openssl rand -base64 48
#   PowerShell: [Convert]::ToBase64String((1..48 | % { [byte](Get-Random -Max 256) }))
JWT_SECRET=

# Porta em que a aplicação fica disponível no host
WEB_PORT=4200
# Só é necessário se acessar o back-end de outra origem (mantenha igual à URL do navegador)
CORS_ORIGINS=http://localhost:4200
